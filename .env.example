# Port for the Express backend server
PORT=5000

# PostgreSQL Connection String:
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Local: postgresql://postgres:postgres@localhost:5432/senior_invitation
# Cloud (Neon, Supabase, etc.): postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/senior_invitation
